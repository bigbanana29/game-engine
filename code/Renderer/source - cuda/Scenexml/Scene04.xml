<Scene>

    <!-- 相机配置（保持你的参数） -->
    <Camera>
        <Position>0, 0.6, -2.58</Position>
        <Target>0, 0.61, 3</Target>
        <Up>0, 1, 0</Up>
        <NearZ>0.1</NearZ>
        <FarZ>1000</FarZ>
        <Fov>45</Fov>
    </Camera>

    <Materials>
        <Material>
            <Name>M_Lambert_Red</Name>
            <Type>Lambert</Type>
            <Albedo>0.6, 0.2, 0.2</Albedo>
        </Material>
        <Material>
            <Name>M_Lambert_Blue</Name>
            <Type>Lambert</Type>
            <Albedo>0.2, 0.2, 0.6</Albedo>
        </Material>
        <Material>
            <Name>M_Lambert_Gray</Name>
            <Type>Lambert</Type>
            <Albedo>0.5, 0.5, 0.5</Albedo>
        </Material>
    </Materials>

    <SceneObjects>
        <!-- left sphere -->
        <SceneObject>
            <Transform>
                <Position>-0.4, 0.3, 0.3</Position>
                <Rotation>0, 0, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Material>M_Lambert_Gray</Material>
            <Primitives>
                <Sphere>
                    <Radius>0.3</Radius>
                </Sphere>
            </Primitives>
        </SceneObject>

        <!-- right sphere -->
        <SceneObject>
            <Transform>
                <Position>0.4, 0.3, -0.3</Position>
                <Rotation>0, 0, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Material>M_Lambert_Gray</Material>
            <Primitives>
                <Sphere>
                    <Radius>0.3</Radius>
                </Sphere>
            </Primitives>
        </SceneObject>

        <!-- ground -->
        <SceneObject>
            <Transform>
                <Position>0, 0, 0</Position>
                <Rotation>-90, 0, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Material>M_Lambert_Gray</Material>
            <Primitives>
                <Triangle>
                    <V0>-1, -1, 0</V0>
                    <V1>1, -1, 0</V1>
                    <V2>1, 1, 0</V2>
                </Triangle>
                <Triangle>
                    <V0>-1, -1, 0</V0>
                    <V1>1, 1, 0</V1>
                    <V2>-1, 1, 0</V2>
                </Triangle>
            </Primitives>
        </SceneObject>

        <!-- ceiling -->
        <SceneObject>
            <Transform>
                <Position>0, 1.5, 0</Position>
                <Rotation>90, 0, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Material>M_Lambert_Gray</Material>
            <Primitives>
                <Triangle>
                    <V0>-1, -1, 0</V0>
                    <V1>1, -1, 0</V1>
                    <V2>1, 1, 0</V2>
                </Triangle>
                <Triangle>
                    <V0>-1, -1, 0</V0>
                    <V1>1, 1, 0</V1>
                    <V2>-1, 1, 0</V2>
                </Triangle>
            </Primitives>
        </SceneObject>

        <!-- left wall -->
        <SceneObject>
            <Transform>
                <Position>-1, 0.75, 0</Position>
                <Rotation>0, 90, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Material>M_Lambert_Red</Material>
            <Primitives>
                <Triangle>
                    <V0>-1, -0.75, 0</V0>
                    <V1>1, -0.75, 0</V1>
                    <V2>1, 0.75, 0</V2>
                </Triangle>
                <Triangle>
                    <V0>-1, -0.75, 0</V0>
                    <V1>1, 0.75, 0</V1>
                    <V2>-1, 0.75, 0</V2>
                </Triangle>
            </Primitives>
        </SceneObject>

        <!-- right wall -->
        <SceneObject>
            <Transform>
                <Position>1, 0.75, 0</Position>
                <Rotation>0, -90, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Material>M_Lambert_Red</Material>
            <Primitives>
                <Triangle>
                    <V0>-1, -0.75, 0</V0>
                    <V1>1, -0.75, 0</V1>
                    <V2>1, 0.75, 0</V2>
                </Triangle>
                <Triangle>
                    <V0>-1, -0.75, 0</V0>
                    <V1>1, 0.75, 0</V1>
                    <V2>-1, 0.75, 0</V2>
                </Triangle>
            </Primitives>
        </SceneObject>

        <!-- back wall -->
        <SceneObject>
            <Transform>
                <Position>0, 0.75, 1</Position>
                <Rotation>180, 0, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Material>M_Lambert_Gray</Material>
            <Primitives>
                <Triangle>
                    <V0>-1, -0.75, 0</V0>
                    <V1>1, -0.75, 0</V1>
                    <V2>1, 0.75, 0</V2>
                </Triangle>
                <Triangle>
                    <V0>-1, -0.75, 0</V0>
                    <V1>1, 0.75, 0</V1>
                    <V2>-1, 0.75, 0</V2>
                </Triangle>
            </Primitives>
        </SceneObject>
    </SceneObjects>

    <!-- 灯光配置（保持你的参数） -->
    <Lights>
        <!-- 方向光（注释掉了，保持原样） -->
        <!--
        <DirectionalLight>
            <Direction>1, -2, 0.4</Direction>
            <Radiance>1, 1, 1.0</Radiance>
        </DirectionalLight>
        -->

        <!-- 点光源 -->
        <PointLight>
            <Position>0, 1, 0</Position>
            <Intensity>0.3, 0.3, 1.1</Intensity>
            <Attenuations>1, 0, 0</Attenuations>
        </PointLight>

        <!-- 聚光灯 -->
        <SpotLight>
            <Position>-0.8, 0.9, 0</Position>
            <Direction>2, -1, 0</Direction>
            <Intensity>1.2, 0.8, 1</Intensity>
            <InnerAngle>10</InnerAngle>
            <OuterAngle>60</OuterAngle>
            <Attenuations>1, 0, 0</Attenuations>
        </SpotLight>
    </Lights>

</Scene>